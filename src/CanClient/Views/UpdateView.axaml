<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="CanClient.Views.UpdateView"
             Width="340">
  <!-- 客户端仅提醒，更新由独立更新器负责。 -->
  <StackPanel Spacing="{DynamicResource Space.Md}">
    <TextBlock Text="当前客户端已有新版本，请通过独立更新器更新。" TextWrapping="Wrap" />
    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="16" RowSpacing="6">
      <TextBlock Classes="muted" Text="当前版本" />
      <TextBlock x:Name="CurrentText" Grid.Column="1" Classes="mono" />
      <TextBlock Grid.Row="1" Classes="muted" Text="新版本" />
      <TextBlock x:Name="NewText" Grid.Row="1" Grid.Column="1" Classes="mono" />
    </Grid>
  </StackPanel>
</UserControl>
