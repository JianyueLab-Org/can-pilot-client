<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CanClient.ViewModels"
             x:Class="CanClient.Views.Settings.UpdatesPage"
             x:DataType="vm:SettingsViewModel">
  <!-- vPilot SettingsPanelUpdates -->
  <StackPanel Spacing="6">
    <CheckBox Content="启动时检查新版本并提醒" IsChecked="{Binding CheckForUpdates}" />
    <TextBlock Classes="caption" Text="客户端仅提供新版本提醒，更新由独立更新器负责。" TextWrapping="Wrap" />
    <TextBlock Classes="caption" Text="{Binding VersionText}" />
  </StackPanel>
</UserControl>
