<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CanClient.ViewModels"
             x:Class="CanClient.Views.Settings.SimulatorPage"
             x:DataType="vm:SettingsViewModel">
  <StackPanel Spacing="8">
    <TextBlock Classes="label" Text="模拟器接入" />
    <ComboBox ItemsSource="{Binding SimulatorConnections}" SelectedItem="{Binding SimulatorConnection}" IsEnabled="{Binding CanChangeSimulator}" />
    <TextBlock Classes="caption" Text="Auto：自动检测 MSFS / X-Plane，优先保持已接入的模拟器；联飞时锁定，断开网络后才能切换。" TextWrapping="Wrap" />
    <TextBlock Classes="section" Text="X-Plane 11 / 12" Margin="0,10,0,0" />
    <TextBlock Classes="label" Text="X-Plane 安装目录" />
    <TextBox Text="{Binding XPlanePath}" PlaceholderText="包含 Resources/plugins 的根目录" />
    <StackPanel Orientation="Horizontal" Spacing="8">
      <Button Content="浏览目录" Click="OnBrowseXPlaneClick" />
      <Button Content="自动查找" Command="{Binding DiscoverXPlaneCommand}" />
      <Button Content="安装 / 更新交通插件" Command="{Binding InstallXPlanePluginCommand}" />
    </StackPanel>
    <TextBlock Classes="caption" Text="{Binding XPlaneStatus}" TextWrapping="Wrap" />
    <TextBlock Classes="label" Text="CSL 模型库目录（X-CSL / xPilot / LiveTraffic）" />
    <TextBox Text="{Binding CslPath}" />
    <StackPanel Orientation="Horizontal" Spacing="8">
      <Button Content="浏览 CSL" Click="OnBrowseCslClick" />
      <Button Content="扫描 CSL 模型" Command="{Binding ScanCslCommand}" />
    </StackPanel>
    <TextBlock Classes="caption" Text="{Binding CslStatus}" TextWrapping="Wrap" />
    <TextBlock Classes="label" Text="X-Plane UDP 主机（留空自动发现）" />
    <TextBox Text="{Binding XPlaneHost}" PlaceholderText="自动 / 127.0.0.1" />
    <NumericUpDown Minimum="1" Maximum="65535" Value="{Binding XPlanePort}" FormatString="0" />
    <TextBlock Classes="caption" Text="原生交通插件使用本机 49900 端口；客户端与 X-Plane 请在同一台电脑运行。MSFS 模型匹配继续在原有模型匹配页面设置。" TextWrapping="Wrap" />
  </StackPanel>
</UserControl>
