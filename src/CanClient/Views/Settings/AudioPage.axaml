<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CanClient.ViewModels"
             x:Class="CanClient.Views.Settings.AudioPage"
             x:DataType="vm:SettingsViewModel">
  <!-- vPilot SettingsPanelAudio：设备、音量、电平表；降噪是 RNNoise -->
  <StackPanel Width="360" HorizontalAlignment="Left">
    <TextBlock Classes="label" Text="麦克风设备" />
    <ComboBox ItemsSource="{Binding InputDevices}" SelectedItem="{Binding InputDeviceName}" HorizontalAlignment="Stretch" />
    <TextBlock Classes="label" Text="输出设备" />
    <ComboBox ItemsSource="{Binding OutputDevices}" SelectedItem="{Binding OutputDeviceName}" HorizontalAlignment="Stretch" />

    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
      <CheckBox Content="麦克风降噪（RNNoise）" IsChecked="{Binding MicDenoise}" IsEnabled="{Binding DenoiseAvailable}" />
      <TextBlock Classes="caption" VerticalAlignment="Center" Text="{Binding DenoiseNote}" />
    </StackPanel>

    <Grid ColumnDefinitions="72,*,32" RowDefinitions="Auto,Auto" Margin="0,6,0,0">
      <TextBlock Classes="muted" Text="输出音量" VerticalAlignment="Center" />
      <Slider Grid.Column="1" Minimum="-18" Maximum="18" TickFrequency="1" IsSnapToTickEnabled="True"
              Value="{Binding OutputVolumeDb}" />
      <TextBlock Grid.Column="2" Classes="mono" Text="{Binding OutputVolumeText}" HorizontalAlignment="Right" VerticalAlignment="Center" />

      <TextBlock Grid.Row="1" Classes="muted" Text="麦克风音量" VerticalAlignment="Center" />
      <Slider Grid.Row="1" Grid.Column="1" Minimum="-60" Maximum="18" TickFrequency="1" IsSnapToTickEnabled="True"
              Value="{Binding InputVolumeDb}" />
      <TextBlock Grid.Row="1" Grid.Column="2" Classes="mono" Text="{Binding InputVolumeText}" HorizontalAlignment="Right" VerticalAlignment="Center" />
    </Grid>

    <!-- 输入电平表（vPilot LevelMeterInput）：中段为合适音量区间 -->
    <Grid Margin="72,6,32,0" Height="6">
      <Grid ColumnDefinitions="45*,35*,20*" ColumnSpacing="2">
        <Border CornerRadius="2" Background="{DynamicResource Brush.Bg.Hover}" />
        <Border Grid.Column="1" CornerRadius="2" Background="{DynamicResource Brush.Bg.Active}" />
        <Border Grid.Column="2" CornerRadius="2" Background="{DynamicResource Brush.Bg.Hover}" />
      </Grid>
      <ProgressBar Value="{Binding InputLevel}" Maximum="100" MinHeight="6" Height="6"
                   Background="Transparent" Foreground="{DynamicResource Brush.Success}" />
    </Grid>
    <TextBlock Classes="caption" Margin="72,8,0,0" TextWrapping="Wrap"
               Text="调整麦克风音量，使正常说话时电平保持在中段区间内。" />
  </StackPanel>
</UserControl>
