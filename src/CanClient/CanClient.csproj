<Project Sdk="Microsoft.NET.Sdk">

  <!-- 界面：Avalonia 12（Simple 主题打底 + 自定义主题），布局参考 vPilot。业务逻辑都在 CanClient.Core。 -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <AssemblyName>can-pilot</AssemblyName>
    <RootNamespace>CanClient</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.0" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.0" />
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="12.1.0" />
    <PackageReference Include="Avalonia.Themes.Simple" Version="12.1.0" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="app.ico" />
    <AvaloniaResource Include="app-logo.png" />
    <ProjectReference Include="..\CanClient.Core\CanClient.Core.csproj" />
    <None Update="**\can-pilot.debug.json" CopyToOutputDirectory="Never" CopyToPublishDirectory="Never" />
  </ItemGroup>

  <!--
    FSX / P3D 的 SimConnect 桥接进程（32 位 NativeAOT）和 32 位 SimConnect.dll 放在输出目录的 fsx 子目录，
    不打进单文件 EXE。只在 Windows 上构建；需要 VS 的 C++ 工具（和 RNNoise 一样）。没有的话只是接不了 FSX / P3D，
    构建照常完成。-p:SkipSimConnectBridge=true 可以跳过。
  -->
  <PropertyGroup>
    <SimBridgeProject>$(MSBuildThisFileDirectory)..\CanClient.SimBridge\CanClient.SimBridge.csproj</SimBridgeProject>
  </PropertyGroup>
  <ItemGroup>
    <SimBridgeInput Include="..\CanClient.SimBridge\*.cs;..\CanClient.SimBridge\*.csproj;..\..\native\fsx\SimConnect.dll" />
  </ItemGroup>

  <!-- OutDir 要到 SDK 的 targets 里才定下来，所以在目标里取 -->
  <Target Name="SimBridgePaths">
    <PropertyGroup>
      <SimBridgeOutput>$(OutDir)fsx</SimBridgeOutput>
    </PropertyGroup>
  </Target>

  <Target Name="PublishSimConnectBridge" AfterTargets="Build" DependsOnTargets="SimBridgePaths"
          Condition="'$(CanTargetsWindows)' == 'true' and $([MSBuild]::IsOSPlatform('Windows')) and '$(SkipSimConnectBridge)' != 'true' and '$(DesignTimeBuild)' != 'true'"
          Inputs="@(SimBridgeInput)" Outputs="$(SimBridgeOutput)\can-simconnect.exe;$(SimBridgeOutput)\SimConnect.dll">
    <!-- VS 不在默认位置时，它的 vcvarsall 会按 PATH 找 vswhere.exe -->
    <Exec Command="dotnet publish &quot;$(SimBridgeProject)&quot; -c Release -o &quot;$(SimBridgeOutput)&quot; -nologo -v:q"
          EnvironmentVariables="PATH=$([MSBuild]::Escape('$(PATH);$(MSBuildProgramFiles32)\Microsoft Visual Studio\Installer'))"
          ContinueOnError="WarnAndContinue" />
  </Target>

  <Target Name="PublishSimConnectBridgeFiles" AfterTargets="Publish" DependsOnTargets="SimBridgePaths">
    <ItemGroup>
      <SimBridgeFile Include="$(SimBridgeOutput)\can-simconnect.exe;$(SimBridgeOutput)\SimConnect.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(SimBridgeFile)" DestinationFolder="$(PublishDir)fsx" SkipUnchangedFiles="true"
          Condition="Exists('$(SimBridgeOutput)\can-simconnect.exe')" />
  </Target>

  <Target Name="ExcludeNativeDebugSymbolsFromSingleFilePublish" AfterTargets="ComputeFilesToPublish"
          Condition="'$(PublishSingleFile)' == 'true'">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Extension)' == '.pdb'" />
    </ItemGroup>
  </Target>

  <Target Name="RemovePublishedDebugSymbols" AfterTargets="Publish" Condition="'$(PublishSingleFile)' == 'true'">
    <ItemGroup>
      <PublishedDebugSymbols Include="$(PublishDir)**\*.pdb" />
    </ItemGroup>
    <Delete Files="@(PublishedDebugSymbols)" />
  </Target>

</Project>
