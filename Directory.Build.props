<Project>
  <!-- 所有项目共用的编译设置。客户端只在 Windows x64 上跑：SimConnect、opus、RNNoise 都是 x64 原生库。 -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <!-- 正式版本号由 CI 通过 CAN_VERSION 传入；本地构建按开发版处理。 -->
    <Version Condition="'$(CAN_VERSION)' != ''">$(CAN_VERSION)</Version>
    <Version Condition="'$(CAN_VERSION)' == ''">2.2.35</Version>
    <CanReleaseBuild Condition="'$(CAN_VERSION)' != ''">true</CanReleaseBuild>
    <CanReleaseBuild Condition="'$(CAN_VERSION)' == ''">false</CanReleaseBuild>
    <Company>JianyueLab</Company>
    <Product>MSFS for CAN</Product>
  </PropertyGroup>
</Project>
