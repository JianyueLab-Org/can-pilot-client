<Project>
  <!--
    所有项目共用的编译设置。Windows x64 支持 MSFS（SimConnect）和 X-Plane；
    macOS（arm64 / x64）和 Linux x64 只接 X-Plane，音频走 OpenAL Soft，Opus 用托管实现。
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <SelfContained>false</SelfContained>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <!-- 正式版本号；CI 可通过 CAN_VERSION 覆盖。 -->
    <Version Condition="'$(CAN_VERSION)' != ''">$(CAN_VERSION)</Version>
    <Version Condition="'$(CAN_VERSION)' == ''">3.0.0</Version>
    <Company>JianyueLab</Company>
    <Product>CAN Pilot Client</Product>
  </PropertyGroup>

  <!-- Windows 上 SimConnect、opus、RNNoise 都是 x64 原生库，ARM64 Windows 也按 x64 跑。 -->
  <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('Windows')) and '$(RuntimeIdentifier)' == ''">
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
  </PropertyGroup>

  <!-- 目标是不是 Windows：发布时看 -r，本机编译看宿主系统。决定 SimConnect / opus.dll 要不要随包。 -->
  <PropertyGroup>
    <CanTargetsWindows Condition="'$(RuntimeIdentifier)' != '' and $(RuntimeIdentifier.StartsWith('win'))">true</CanTargetsWindows>
    <CanTargetsWindows Condition="'$(RuntimeIdentifier)' == '' and $([MSBuild]::IsOSPlatform('Windows'))">true</CanTargetsWindows>
  </PropertyGroup>
</Project>
